<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Configuration lives directly on the Company record (Settings >
         Companies) rather than in the Employees/Attendances settings page,
         since that page's internal layout isn't a stable inheritance
         target across Odoo 17 builds. -->
    <record id="res_company_view_form_mood" model="ir.ui.view">
        <field name="name">res.company.form.mood.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Face &amp; Mood Attendance" name="mood_attendance">
                    <field name="mood_sad_threshold_days"/>
                    <field name="mood_confidence_threshold"/>
                    <field name="mood_incentive_amount"/>
                    <field name="mood_kiosk_model_url"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
