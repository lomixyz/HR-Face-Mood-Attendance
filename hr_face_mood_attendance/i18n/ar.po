#. module: hr_face_mood_attendance
#: model:ir.model.fields,field_description:hr_face_mood_attendance.field_hr_employee__mood_consent
msgid "Consents to Face ID & Mood Detection"
msgstr "موافقة على التعرف على الوجه وقراءة المزاج"

#. module: hr_face_mood_attendance
#: model:ir.model.fields,help:hr_face_mood_attendance.field_hr_employee__mood_consent
msgid "The employee has explicitly agreed to have their face used for attendance recognition and to have their facial expression read at check-in/out to estimate mood. No face data is captured, matched or scored until this is checked."
msgstr "وافق الموظف صراحة على استخدام وجهه للتعرف عليه لتسجيل الحضور، وعلى قراءة تعابير وجهه عند تسجيل الدخول/الخروج لتقدير المزاج. لن يتم التقاط أو مطابقة أو تقييم أي بيانات للوجه قبل تفعيل هذا الخيار."

#. module: hr_face_mood_attendance
#: model:ir.model.fields,field_description:hr_face_mood_attendance.field_hr_employee__mood_consent_date
msgid "Consent Given On"
msgstr "تاريخ الموافقة"

#. module: hr_face_mood_attendance
#: model:ir.model.fields,field_description:hr_face_mood_attendance.field_hr_employee__face_descriptor
msgid "Face Descriptor"
msgstr "بصمة الوجه (Descriptor)"

#. module: hr_face_mood_attendance
#: model:ir.model.fields,help:hr_face_mood_attendance.field_hr_employee__face_descriptor
msgid "Mathematical representation (128-d vector, JSON encoded) of the employee's face, computed in the browser. This is NOT a photo and cannot be used to reconstruct one, but it is still biometric data - treat it as sensitive."
msgstr "تمثيل رياضي (متجه من 128 رقماً، بصيغة JSON) لوجه الموظف، يُحسب داخل المتصفح. هذا ليس صورة فوتوغرافية ولا يمكن استخدامه لإعادة بناء صورة، لكنه يبقى بيانات بيومترية حساسة ويجب التعامل معه على هذا الأساس."

#. module: hr_face_mood_attendance
#: model:ir.model.fields,field_description:hr_face_mood_attendance.field_hr_employee__face_enrolled_on
msgid "Face Enrolled On"
msgstr "تاريخ تسجيل الوجه"

#. module: hr_face_mood_attendance
#: model:ir.model.fields,field_description:hr_face_mood_attendance.field_hr_employee__face_is_enrolled
msgid "Face Enrolled"
msgstr "تم تسجيل الوجه"

#. module: hr_face_mood_attendance
#: model:ir.model.fields,field_description:hr_face_mood_attendance.field_hr_employee__mood_consecutive_sad_days
msgid "Consecutive Sad Days"
msgstr "أيام الحزن المتتالية"

#. module: hr_face_mood_attendance
#: model:ir.model.fields,help:hr_face_mood_attendance.field_hr_employee__mood_consecutive_sad_days
msgid "Number of consecutive attended days, ending on the most recent attendance, whose dominant recorded mood was 'sad'."
msgstr "عدد أيام الحضور المتتالية، وصولاً إلى آخر حضور، التي كانت الحالة المزاجية السائدة المسجّلة فيها \"حزين\"."

#. module: hr_face_mood_attendance
#: model:ir.model.fields,field_description:hr_face_mood_attendance.field_hr_employee__mood_streak_action_taken
msgid "Wellbeing Workflow Already Triggered"
msgstr "تم تفعيل مسار متابعة الحالة المعنوية بالفعل"

#. module: hr_face_mood_attendance
#: model:ir.model.fields,help:hr_face_mood_attendance.field_hr_employee__mood_streak_action_taken
msgid "Prevents the wellbeing workflow (notification / draft leave / incentive) from firing again every day once the threshold has been reached; it resets automatically once the streak breaks."
msgstr "يمنع تكرار تفعيل مسار متابعة الحالة المعنوية (إشعار / إجازة / حافز) كل يوم بعد الوصول إلى الحد المحدد؛ ويُعاد ضبطه تلقائياً بمجرد انقطاع سلسلة الأيام."

#. module: hr_face_mood_attendance
#: model:ir.model.fields,field_description:hr_face_mood_attendance.field_hr_employee__mood_last_action_date
msgid "Wellbeing Workflow Last Triggered On"
msgstr "آخر تاريخ لتفعيل مسار متابعة الحالة المعنوية"

