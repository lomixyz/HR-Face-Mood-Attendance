#. module: hr_face_mood_attendance
#: code:addons/hr_face_mood_attendance/models/hr_employee.py:0
msgid "You need to give your consent to face recognition and mood detection before enrolling your face."
msgstr "يجب عليك الموافقة على التعرف على الوجه وقراءة المزاج قبل تسجيل وجهك."

#. module: hr_face_mood_attendance
#: code:addons/hr_face_mood_attendance/models/hr_employee.py:0
msgid "No valid face descriptor was captured."
msgstr "لم يتم التقاط بصمة وجه صالحة."

#. module: hr_face_mood_attendance
#: code:addons/hr_face_mood_attendance/models/hr_employee.py:0
msgid "Wellbeing support - suggested after %s consecutive days of low mood. Please review with the employee before confirming."
msgstr "دعم معنوي - مقترح بعد %s يوم عمل متتالي بحالة مزاجية منخفضة. يرجى المراجعة مع الموظف قبل التأكيد."

#. module: hr_face_mood_attendance
#: code:addons/hr_face_mood_attendance/models/hr_employee.py:0
msgid "(not created - no wellbeing leave type configured)"
msgstr "(لم تُنشأ - لا يوجد نوع إجازة معنوية مُهيّأ)"

#. module: hr_face_mood_attendance
#: code:addons/hr_face_mood_attendance/models/hr_employee.py:0
msgid ""
"%(name)s has had a dominantly low/sad mood at check-in or "
"check-out for %(streak)s consecutive attended days.\n"
"Please check in with them. A draft wellbeing leave %(leave)s "
"and a suggested incentive have been prepared for your review; "
"nothing has been confirmed automatically."
msgstr ""
"لوحظ أن الحالة المزاجية لـ %(name)s كانت سلبية/حزينة بشكل غالب عند تسجيل الدخول أو الخروج "
"لمدة %(streak)s يوم عمل متتالي.\n"
"يرجى التواصل مع الموظف للاطمئنان عليه. تم تجهيز مسودة إجازة معنوية %(leave)s "
"وحافز مقترح لمراجعتك؛ لم يتم تأكيد أي شيء تلقائياً."

#. module: hr_face_mood_attendance
#: code:addons/hr_face_mood_attendance/models/hr_employee.py:0
msgid "Wellbeing check-in needed: %s"
msgstr "مطلوب الاطمئنان على الحالة المعنوية: %s"

#. module: hr_face_mood_attendance
#: model:ir.model.fields,field_description:hr_face_mood_attendance.field_hr_attendance__mood_check_in
msgid "Mood at Check-In"
msgstr "الحالة المزاجية عند تسجيل الدخول"

#. module: hr_face_mood_attendance
#: model:ir.model.fields,help:hr_face_mood_attendance.field_hr_attendance__mood_check_in
msgid "Dominant facial expression read by the kiosk at check-in time."
msgstr "تعبير الوجه السائد الذي رصده الكشك عند وقت تسجيل الدخول."

#. module: hr_face_mood_attendance
#: model:ir.model.fields,field_description:hr_face_mood_attendance.field_hr_attendance__mood_check_in_confidence
msgid "Check-In Mood Confidence"
msgstr "نسبة الثقة في مزاج تسجيل الدخول"

#. module: hr_face_mood_attendance
#: model:ir.model.fields,help:hr_face_mood_attendance.field_hr_attendance__mood_check_in_confidence
msgid "Confidence (0 to 1) reported by the browser's expression model."
msgstr "نسبة الثقة (من 0 إلى 1) التي أبلغ عنها نموذج تحليل التعابير في المتصفح."

#. module: hr_face_mood_attendance
#: model:ir.model.fields,field_description:hr_face_mood_attendance.field_hr_attendance__mood_check_out
msgid "Mood at Check-Out"
msgstr "الحالة المزاجية عند تسجيل الخروج"

#. module: hr_face_mood_attendance
#: model:ir.model.fields,field_description:hr_face_mood_attendance.field_hr_attendance__mood_check_out_confidence
msgid "Check-Out Mood Confidence"
msgstr "نسبة الثقة في مزاج تسجيل الخروج"

#. module: hr_face_mood_attendance
#: model:ir.model.fields,field_description:hr_face_mood_attendance.field_res_company__mood_sad_threshold_days
msgid "Consecutive Sad Days Threshold"
msgstr "حد أيام الحزن المتتالية"

#. module: hr_face_mood_attendance
#: model:ir.model.fields,help:hr_face_mood_attendance.field_res_company__mood_sad_threshold_days
msgid "Number of consecutive attended days with a dominant 'sad' mood before the wellbeing workflow (notification / draft leave / incentive) is triggered for an employee."
msgstr "عدد أيام الحضور المتتالية بحالة مزاجية \"حزينة\" سائدة قبل تفعيل مسار متابعة الحالة المعنوية (إشعار / إجازة / حافز) للموظف."

#. module: hr_face_mood_attendance
#: model:ir.model.fields,field_description:hr_face_mood_attendance.field_res_company__mood_confidence_threshold
msgid "Mood Confidence Threshold"
msgstr "حد الثقة في قراءة المزاج"

#. module: hr_face_mood_attendance
#: model:ir.model.fields,help:hr_face_mood_attendance.field_res_company__mood_confidence_threshold
msgid "Minimum confidence (0 to 1) the browser's expression model must report before a mood reading counts towards the streak."
msgstr "الحد الأدنى لنسبة الثقة (من 0 إلى 1) التي يجب أن يبلغ عنها نموذج تحليل التعابير في المتصفح حتى تُحتسب قراءة المزاج ضمن سلسلة الأيام."

#. module: hr_face_mood_attendance
#: model:ir.model.fields,field_description:hr_face_mood_attendance.field_res_company__mood_leave_type_id
msgid "Wellbeing Leave Type"
msgstr "نوع الإجازة المعنوية"

#. module: hr_face_mood_attendance
#: model:ir.model.fields,help:hr_face_mood_attendance.field_res_company__mood_leave_type_id
msgid "Leave type used when auto-creating a draft leave request for an employee who hits the sad-streak threshold. Leave empty to skip automatic leave creation and only notify HR / the manager."
msgstr "نوع الإجازة المستخدم عند إنشاء مسودة طلب إجازة تلقائياً لموظف وصل إلى حد سلسلة أيام الحزن. اتركه فارغاً لتخطي الإنشاء التلقائي والاكتفاء بإشعار إدارة الموارد البشرية/المدير."

#. module: hr_face_mood_attendance
#: model:ir.model.fields,field_description:hr_face_mood_attendance.field_res_company__mood_incentive_amount
msgid "Wellbeing Incentive Amount"
msgstr "قيمة حافز المتابعة المعنوية"

#. module: hr_face_mood_attendance
#: model:ir.model.fields,help:hr_face_mood_attendance.field_res_company__mood_incentive_amount
msgid "Suggested amount to log on the wellbeing incentive record when the threshold is hit. This does NOT post anything to payroll automatically - it is a proposal for HR/payroll to review and apply manually (e.g. as a payslip input)."
msgstr "المبلغ المقترح تسجيله في سجل حافز المتابعة المعنوية عند بلوغ الحد المحدد. لا يتم ترحيل أي شيء تلقائياً إلى الرواتب - هذا مجرد اقتراح تراجعه إدارة الموارد البشرية/الرواتب وتطبقه يدوياً (مثلاً كمدخل في مسير الراتب)."

#. module: hr_face_mood_attendance
#: model:ir.model.fields,field_description:hr_face_mood_attendance.field_res_company__mood_kiosk_model_url
msgid "Face/Mood Model URL"
msgstr "رابط نموذج التعرف على الوجه/المزاج"

#. module: hr_face_mood_attendance
#: model:ir.model.fields,help:hr_face_mood_attendance.field_res_company__mood_kiosk_model_url
msgid "Base URL the kiosk page loads the face-api.js AI model weights from. Defaults to a public CDN. For an offline/on-premise deployment, host the weights yourself (see module README) and point this at that URL instead."
msgstr "الرابط الأساسي الذي تحمّل منه صفحة الكشك أوزان نموذج الذكاء الاصطناعي face-api.js. القيمة الافتراضية هي شبكة توزيع محتوى عامة (CDN). للنشر دون اتصال بالإنترنت/على خوادم داخلية، استضف الأوزان بنفسك (راجع ملف README الخاص بالموديول) ووجّه هذا الحقل إلى ذلك الرابط."

